{
  "manifest_version": 3,
  "name": "Spoken Token",
  "version": "0.1.0",
  "description": "Read the current webpage aloud with a private speech engine on this computer.",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Spoken Token",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Spoken Token"
    }
  }
}
